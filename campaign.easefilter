    SetBackgroundColor 216 8 8
    Continue
#PART:----- Jewels
Show
Class == "Abyss Jewels" "Jewels"
    SetBackgroundColor 64 88 128
    Continue
#PART:----- Fragments
Show
Class == "Map Fragments"
    SetBackgroundColor 192 192 192
    Continue
#PART:----- Maps
Show
Class == "Maps"
    SetBackgroundColor 8 8 8
    Continue
#PART:--- Border
#PART:----- Strength Bases
Show
BaseArmour >= 1
    SetBorderColor 248 8 8
    Continue
Show
Class == "One Hand Maces" "Two Hand Maces"
    SetBorderColor 248 8 8
    Continue
#PART:----- Dexterity Bases
