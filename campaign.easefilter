# ============================================================================ #
# COMMENT
# TODO: remove all leftovers for atlas and map related filtering
# TODO: remove all filtering for removed (but still accessible via standard)
# \ items, so they would show as Mistaken (Error) items with danger sound
# DO NOT USE THIS FILTER PAST CAMPAIGN GAME CONTENT!!!
# filter only for campaign
# this filter not highlight any item that drops only in atlas (mapping) content
# it is purely designs for campaign play-through (hate mapping content anyway)
# filter based on `items` filters (which is no longer supported!)
# items from campaign only or contents available from campaign,
# maps are hidden in base game and show as fully transparent font size 18 in
# ruthless mode
# END OF COMMENT
# ============================================================================ #
# FILTER
#PART:- Continue
#PART:--- Mandatory
#PART:----- Starting
Show
AreaLevel 1
BaseType == "Spectral Throw"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/CstleTown.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Double Strike"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/Dungeon.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Viper Strike"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/FortressTown.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Heavy Strike"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/InfernoTown.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Fireball"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/NecroTown.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Burning Arrow"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/Rampart.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
Show
AreaLevel 1
BaseType == "Holy Strike"
Class == "Skill Gems"
    CustomAlertSound "homm3snd/starting/StrongHold.mp3" 150
    MinimapIcon 0 Grey Pentagon
    PlayEffect Grey
    SetFontSize 45
#PART:----- Quest Items
Show
Class == "Quest Items"
    SetFontSize 45
    CustomAlertSound "homm3snd/DEFAULT.wav"
    MinimapIcon 0 Green Cross
    PlayEffect Green
#PART:----- Gold
Show
BaseType == "Gold"
StackSize >= 4096
    SetFontSize 45
    MinimapIcon 2 Orange Circle
    SetBackgroundColor 0 0 0 0
    SetBorderColor 0 0 0 0
    SetTextColor 248 216 64
Show
BaseType == "Gold"
StackSize >=  512
    SetFontSize 42
    SetBackgroundColor 0 0 0 0
    SetBorderColor 0 0 0 0
    SetTextColor 216 192 32
Show
BaseType == "Gold"
StackSize >= 64
    SetFontSize 39
    SetBackgroundColor 0 0 0 0
    SetBorderColor 0 0 0 0
    SetTextColor 192 160 32
Show
BaseType == "Gold"
StackSize >= 8
    SetFontSize 36
    SetBackgroundColor 0 0 0 0
    SetBorderColor 0 0 0 0
    SetTextColor 160 128 8
Show
BaseType == "Gold"
    SetFontSize 33
    SetBackgroundColor 0 0 0 0
    SetBorderColor 0 0 0 0
    SetTextColor 128 88 8
#PART:--- Drop Sounds
#PART:----- All Items
Show
    DisableDropSound
    Continue
#PART:--- Text
#PART:----- Normal Rarity
Show
Rarity Normal
    SetTextColor 192 192 192
    Continue
#PART:----- Magic Rarity
Show
Rarity Magic
    SetTextColor 128 128 248
    Continue
#PART:----- Rare Rarity
Show
Rarity Rare
    SetTextColor 248 248 128
    Continue
#PART:----- Unique Rarity
Show
Rarity Unique
    SetTextColor 160 88 32
    Continue
#PART:----- Gems
Show
Class "Gems"
    SetTextColor 32 160 160
    Continue
#PART:----- Fractured
Show
FracturedItem True
    SetTextColor 160 160 88
    Continue
#PART:----- Synthesised
Show
SynthesisedItem True
    SetTextColor 160 160 88
    Continue
#PART:----- Influenced
Show
HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    SetTextColor 160 160 88
    Continue
#PART:----- Corrupted
Show
Corrupted True
    SetTextColor  216 8 8
    Continue
#PART:----- Crafted
Show
Identified True
HasExplicitMod "Veil" "Chosen" "Order" "Craft" "Upgraded" "Subterranean" "Underground"
    SetTextColor 192 216 248
    Continue
#PART:--- Background
#PART:----- Currency
Show
Class == "Stackable Currency"
    SetBackgroundColor 128 88 8
    Continue
#PART:----- Weapons
Show
Class == "Bows" "Claws" "Daggers" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Sceptres" "Staves" "Thrusting One Hand Swords" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords" "Wands" "Warstaves"
    SetBackgroundColor 64 8 8
    Continue
#PART:----- Armours
Show
Class == "Body Armours" "Boots" "Gloves" "Helmets"
    SetBackgroundColor 8 64 8
    Continue
#PART:----- Off-hands
Show
Class == "Quivers" "Shields"
    SetBackgroundColor 64 64 8
    Continue
#PART:----- Jewellery
