#    4     - Specific
##   4.1   --- Sockets
###  4.1.1 ----- 6 link
Show
LinkedSockets 6
    CustomAlertSound "homm3snd/BLOODLUS.wav"
    MinimapIcon 0 Red Pentagon
    PlayEffect Red
    SetTextColor 248 248 248
###  4.1.2 ----- 5 link
Show
LinkedSockets 5
    CustomAlertSound "homm3snd/LIGHTBLT.wav"
    MinimapIcon 0 Orange Pentagon
    PlayEffect Orange
    SetTextColor 248 248 248
###  4.1.3 ----- 6 Socket
Show
Sockets 6
    CustomAlertSound "homm3snd/TREASURE.wav"
    MinimapIcon 0 Orange Pentagon
    PlayEffect Orange
    SetTextColor 248 248 248
###  4.1.4 ----- 4 link
Show
LinkedSockets 4
AreaLevel < 68
    CustomAlertSound "homm3snd/Poison.wav"
    MinimapIcon 2 White Pentagon
    SetTextColor 248 248 248
###  4.1.5 ----- RGB
Show
Class "One Hand" "Gloves" "Helmets" "Shields" "Daggers" "Claws" "Boots" "Wands"
SocketGroup RGB
Rarity Normal
    SetFontSize 42
    SetBackgroundColor 128 88 8
    SetTextColor 8 8 8
Show
Class "Two Hand" "Body Armours" "Staves" "Sceptres" "Bows"
SocketGroup RGB
Rarity Normal
    SetFontSize 36
    SetBackgroundColor 128 88 8
    SetTextColor 8 8 8
###  4.1.6 ----- 3 Link
Show
LinkedSockets 3
AreaLevel < 34
Rarity < Rare
    SetFontSize 39
###  4.1.7 ----- 2 Link
Show
LinkedSockets 2
AreaLevel < 17
Rarity < Magic
    SetFontSize 33
##   4.2   --- Unique
###  4.2.1 ----- Bases
Show
Class == "Belts"
BaseType == "Leather Belt" "Heavy Belt"
Rarity Unique
    CustomAlertSound "homm3snd/BADLUCK.wav"
    MinimapIcon 0 Brown Moon
    PlayEffect Brown
###  4.2.2 ----- Global
Show
Class == "Belts"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 1 Brown Moon
    PlayEffect Brown Temp
Show
Class "Flasks"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 1 Brown Raindrop
    PlayEffect Brown Temp
Show
Class "Jewels"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 1 Brown Star
    PlayEffect Brown Temp
Show
Class == "Amulets" "Rings"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 1 Brown Diamond
    PlayEffect Brown Temp
Show
Class == "Shields" "Quivers"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 2 Brown UpsideDownHouse
Show
Class == "Body Armours" "Gloves" "Boots" "Helmets"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
    MinimapIcon 2 Brown Square
Show
Class "Axes" "Maces" "Daggers" "Claws" "Sceptres" "Bows" "Swords" "Wands" "Staves"
Rarity Unique
    CustomAlertSound "homm3snd/Disease.wav"
