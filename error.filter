##   2.1   --- Basic Vendor
###  2.1.1 ----- Wisdom
Show
Class == "Stackable Currency"
BaseType == "Scroll of Wisdom"
StackSize 40
    CustomAlertSound "homm3snd/FLAGMINE.wav"
    MinimapIcon 2 White Circle
    SetBackgroundColor 180 140 100 255
    SetBorderColor 90 40 50 255
    SetTextColor 90 40 50 255
Show
Class == "Stackable Currency"
BaseType == "Scroll of Wisdom"
StackSize >= 8
    CustomAlertSound "homm3snd/BUTTON.wav"
    MinimapIcon 2 White Circle
    SetBackgroundColor 180 140 100 255
    SetBorderColor 90 40 50 255
    SetTextColor 90 40 50 255
Show
Class == "Stackable Currency"
BaseType == "Scroll of Wisdom"
AreaLevel < 45
    CustomAlertSound "homm3snd/BUTTON.wav"
    MinimapIcon 2 White Circle
    SetBackgroundColor 180 140 100 255
    SetBorderColor 90 40 50 255
    SetTextColor 90 40 50 255
Hide
